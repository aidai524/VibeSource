{
  "name": "vibesource",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:schema": "auth generate --config src/server/auth-schema.ts --output migrations/0001_better_auth.sql --yes",
    "verify:license-policy-source": "node scripts/verify-license-policy-source.mjs",
    "verify:postgres-migrations": "node scripts/verify-postgres-migrations.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run verify:postgres-migrations && npm run build"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "auth": "^1.6.25",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
