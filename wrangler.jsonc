{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vibesource",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c3abf97f88cf4e439cc9e34a7f6c1f3c"
    }
  ]
}
