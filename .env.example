# Submission and review are disabled unless this is explicitly changed to local.
VIBESOURCE_SUBMISSION_MODE=disabled

# Local mode requires an absolute path outside public/ and .next/.
VIBESOURCE_DB_PATH=/absolute/path/to/vibesource.sqlite

# Local editor review additionally requires identity mode "local-token", one of
# editor/license_reviewer/admin, a token of at least 16 characters and a
# server-side actor identifier. Do not commit real credentials.
VIBESOURCE_EDITOR_IDENTITY_MODE=disabled
VIBESOURCE_EDITOR_TOKEN=
VIBESOURCE_EDITOR_ID=
VIBESOURCE_EDITOR_ROLE=editor

# External GitHub OAuth + PostgreSQL sessions are also disabled unless identity
# mode is "external-oidc" and every value below is complete. Production
# BETTER_AUTH_URL must use HTTPS. The PostgreSQL user should use a pooled URL
# and least-privilege grants. A signed-in account still needs an active row in
# vibesource_editor_role_grants; GitHub identity never grants a role by itself.
DATABASE_URL=
# On Cloudflare Workers, a configured HYPERDRIVE binding supplies the database
# URL at request time and is used only when DATABASE_URL is absent.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Disabled by default. "live" allows a local editor to make exactly one
# unauthenticated public GitHub API request per explicit refresh. This uses the
# shared IP rate limit; no GitHub token is read or stored in M2.2a.
VIBESOURCE_GITHUB_EVIDENCE_MODE=disabled

# Disabled by default. "live" lets a local editor issue exactly one pinned HTTPS
# GET per click. Only response headers are observed; redirects are never followed.
VIBESOURCE_DEMO_EVIDENCE_MODE=disabled

# Optional: enable only while using `next dev` with local/remote Cloudflare
# bindings. It starts Wrangler's local bindings proxy and is not needed for
# ordinary lint, typecheck, test or OpenNext builds.
VIBESOURCE_CLOUDFLARE_DEV_BINDINGS=disabled
